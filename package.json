{
  "name": "kanban-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file=.env.local server/dev.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:e2e": "node tests/drag.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.2.0",
    "hono": "^4.13.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^10.0.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
